# Copy to .env.local for local development.
# Values are the public ones from Vercel → Project → Settings → Environment Variables
# (or https://www.sanity.io/manage). Without them the site shows data/projects.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-08-23
